# Safe development profile: full dashboard with synthetic camera and simulated field I/O.
II_HOST=0.0.0.0
II_PORT=5051
II_API_KEY=dev-key
II_AUTONOMY_ENABLED=0
II_POLL_SECONDS=15

II_DATA_ROOT=.

II_SIMULATION_MODE=1
II_FIELD_IO_SIMULATE=1
II_CAMERA_SIMULATE=1
II_CAMERA_SIM_SCENARIO=healthy
II_CAMERA_SIM_PEOPLE=0

II_HARDWARE_BACKEND=MOCK
II_SENSOR_BACKEND=LOCAL
II_STRICT_FIELD_IO=0
II_ZONE_IDS=1
II_ACTIVE_LOW=1

# Keep these for later when you switch to real field hardware.
II_ESP32_SERIAL_PORT=/dev/ttyACM0
II_ESP32_BAUD=115200
II_ESP32_TIMEOUT=2.0
II_ESP32_BOOT_WAIT=2.0
II_ESP32_DHT_PIN=4
II_ESP32_RELAY_PIN=26
II_ESP32_RELAY_ACTIVE_LOW=1

II_DHT_ENABLED=1
II_DHT_MODEL=DHT11
II_DHT_PIN=4

II_MOISTURE_MODE=DIGITAL
II_MOISTURE_PIN=17
II_MOISTURE_ADC_CHANNEL=0
II_MOISTURE_DRY_CAL=0.0
II_MOISTURE_WET_CAL=1.0

II_PRESSURE_MODE=MOCK
II_PRESSURE_PIN=27
II_PRESSURE_ADC_CHANNEL=1
II_PRESSURE_LOW_PSI=8
II_PRESSURE_HIGH_PSI=90

II_ASTRA_TTS_PROVIDER=AUTO
II_ELEVENLABS_API_KEY=
II_ELEVENLABS_VOICE_ID=Rachel
II_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
II_WATER_DETECTION_MIN_MOTION_RATIO=0.01
II_WATER_DETECTION_MIN_WATER_RATIO=0.003
II_WATER_DETECTION_SCORE_THRESHOLD=0.35
II_WATER_DETECTION_CONSECUTIVE=2
